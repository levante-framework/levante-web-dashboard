# Crowdin (approved translations) – used by api/crowdin-approved-translations.js
# For local dev: set in .env or .env.local (never commit the real value).
# For production: set CROWDIN_API_TOKEN in Vercel → Project → Settings → Environment Variables (Production).
CROWDIN_API_TOKEN=

# Optional: Crowdin project ID (default 756721)
# LEVANTE_TRANSLATIONS_PROJECT_ID=756721

# OpenAI (AI-assisted translation judge) – used by api/translation-ai-judge.js and api/asset-history.js
# For local dev: set in .env or .env.local (never commit the real value).
# For production: set in Vercel → Project → Settings → Environment Variables.
OPENAI_API_KEY=

# Optional: OpenAI model (defaults to gpt-4.1 if omitted)
OPENAI_MODEL=gpt-4.1

# Gemini (back-translation quality judge) – used by api/translation-ai-judge.js
# For local dev: set in .env or .env.local (never commit the real value).
# For production: set in Vercel → Project → Settings → Environment Variables.
GEMINI_API_KEY=

# GCS service account JSON for APIs that read private bucket objects.
# Use one of these as a JSON string (single line with escaped newlines).
# GCP_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Audit dashboard data source and access controls (api/audit-dashboard-data.js)
# AUDIT_DASHBOARD_BUCKET=levante-tools
# AUDIT_DASHBOARD_OBJECT=pitwall/audit-mini-dashboard/dashboard-data.json
# AUDIT_DASHBOARD_DOWNLOAD_PREFIX=pitwall/audit-mini-dashboard
# AUDIT_DASHBOARD_REQUIRE_AUTH=true
# AUDIT_DASHBOARD_ALLOWED_ORGS=levante-framework
