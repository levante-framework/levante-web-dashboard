# Crowdin (approved translations) – used by api/crowdin-approved-translations.js
# For local dev: set in .env or .env.local (never commit the real value).
# For production: set CROWDIN_API_TOKEN in Vercel → Project → Settings → Environment Variables (Production).
CROWDIN_API_TOKEN=

# Optional Crowdin OTA distribution hash for the public /translations viewer (server-only).
# If omitted, the viewer falls back to CROWDIN_API_TOKEN + LEVANTE_TRANSLATIONS_PROJECT_ID.
# Do NOT expose this value in client-side bundles or NEXT_PUBLIC vars.
CROWDIN_DISTRIBUTION_HASH=

# Secret used by POST /api/revalidate-translations (x-revalidate-secret header).
# Keep server-only.
REVALIDATE_SECRET=

# Optional: Crowdin project ID (default 756721)
# LEVANTE_TRANSLATIONS_PROJECT_ID=756721

# OpenAI (AI-assisted translation judge) – used by api/translation-ai-judge.js and api/asset-history.js
# For local dev: set in .env or .env.local (never commit the real value).
# For production: set in Vercel → Project → Settings → Environment Variables.
OPENAI_API_KEY=

# Optional: OpenAI model (defaults to gpt-4.1 if omitted)
OPENAI_MODEL=gpt-4.1

# Gemini (back-translation quality judge) – used by api/translation-ai-judge.js
# For local dev: set in .env or .env.local (never commit the real value).
# For production: set in Vercel → Project → Settings → Environment Variables.
GEMINI_API_KEY=

# AQICN / WAQI air quality token – used by api/air-quality.js for the
# privacy-masked air quality lookup on the Locate Me page.
# Get a free token at https://aqicn.org/data-platform/token/ . Server-only.
# For local dev: set in .env or .env.local (never commit the real value).
# For production: set in Vercel → Project → Settings → Environment Variables.
WAQI_TOKEN=

# GCS service account — local dev: use a path to a key file (recommended).
# Production (Vercel): set GCP_SERVICE_ACCOUNT_JSON to the full JSON string.
#
# Local (.env.local):
GOOGLE_APPLICATION_CREDENTIALS=secrets/devkey.json
GCP_SERVICE_ACCOUNT_JSON=secrets/devkey.json
GOOGLE_APPLICATION_CREDENTIALS_JSON=secrets/devkey.json
#
# Production (Vercel dashboard only):
# GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Partner audio translations source config (api/partner-audio-translations.js)
# ASSETS_DRAFT_BUCKET=levante-assets-draft
# ASSETS_DEV_BUCKET=levante-assets-dev
# Default source mode is task-specific JSON under translations/itembank/.
# PARTNER_AUDIO_TRANSLATIONS_SOURCE_MODE=task-json
# Legacy fallback mode options:
# PARTNER_AUDIO_TRANSLATIONS_SOURCE_MODE=csv
# PARTNER_AUDIO_TRANSLATIONS_OBJECT_PATH=audio/item_bank_translations.csv
# PARTNER_AUDIO_TRANSLATIONS_ENABLE_XLIFF_SOURCE=false

# Partner audio language config (api/partner-audio-language-config.js)
# AUDIO_DEV_BUCKET=levante-assets-dev
# LANGUAGE_CONFIG_OBJECT=language_config.json

# Partner task finished + languageoptions update (api/partner-task-finished.js)
# LANGUAGE_OPTIONS_OBJECT=translations/dashboard-consolidated-flat/languageoptions.json
# SLACK_BOT_TOKEN= (optional — posts to #levante-crowdin when task marked finished)
# SLACK_FINISHED_TASK_CHANNEL_ID=#levante-crowdin

# Partner task finished status log prefix (draft bucket)
# PARTNER_TASK_FINISHED_PREFIX=logs/partner-task-finished

# Audit dashboard data source and access controls (api/audit-dashboard-data.js)
# AUDIT_DASHBOARD_BUCKET=levante-tools
# AUDIT_DASHBOARD_OBJECT=pitwall/audit-mini-dashboard/dashboard-data.json
# AUDIT_DASHBOARD_DOWNLOAD_PREFIX=pitwall/audit-mini-dashboard
# AUDIT_DASHBOARD_REQUIRE_AUTH=true
# AUDIT_DASHBOARD_ALLOWED_ORGS=levante-framework
