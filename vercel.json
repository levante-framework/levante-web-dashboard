{
  "version": 2,
  "functions": {
    "api/playht-proxy.js": {
      "maxDuration": 30
    },
    "api/elevenlabs-proxy.js": {
      "maxDuration": 30
    },
    "api/translate-proxy.js": {
      "maxDuration": 30
    },
    "api/read-tags.js": {
      "maxDuration": 30
    },
    "api/language-config.js": {
      "maxDuration": 30
    },
    "api/validation-storage.js": {
      "maxDuration": 30
    },
    "api/visual-audit.js": {
      "maxDuration": 60
    },
    "api/visual-fix.js": {
      "maxDuration": 60
    },
    "api/google-translate.js": {
      "maxDuration": 30
    },
    "api/translation-semantic-score.js": {
      "maxDuration": 30
    },
    "api/list-validation-files.js": {
      "maxDuration": 10,
      "excludeFiles": "data/{tiger,geonames,geocoder}/**"
    },
    "api/get-validation-file.js": {
      "maxDuration": 10,
      "excludeFiles": "data/{tiger,geonames,geocoder}/**"
    },
    "api/save-audio.js": {
      "maxDuration": 60
    },
    "api/crowdin-stats.js": {
      "maxDuration": 30
    },
    "api/crowdin-untranslated.js": {
      "maxDuration": 60
    },
    "api/crowdin-auth.js": {
      "maxDuration": 30
    },
    "api/crowdin-check-permissions.js": {
      "maxDuration": 30
    },
    "api/crowdin-approved-translations.js": {
      "maxDuration": 60
    },
    "api/crowdin-download-zip.js": {
      "maxDuration": 30
    },
    "api/deploy-bucket-docs.js": {
      "maxDuration": 60
    },
    "api/task-assets.js": {
      "maxDuration": 60
    },
    "api/reverse-geocode.js": {
      "maxDuration": 15,
      "includeFiles": "data/geocoder/cities.min.json.gz"
    },
    "api/network-isp.js": {
      "maxDuration": 10,
      "excludeFiles": "data/**"
    },
    "api/location-log.js": {
      "maxDuration": 10,
      "excludeFiles": "data/{tiger,geonames,geocoder}/**"
    },
    "api/tasks-comparison.js": {
      "maxDuration": 30
    },
    "api/asset-audit.js": {
      "maxDuration": 60
    },
    "api/geoboundaries-polygon.js": {
      "maxDuration": 60,
      "excludeFiles": "data/**"
    },
    "api/prolific-es-ar-pilot.js": {
      "maxDuration": 30,
      "includeFiles": "data/validation/{prolific-study-es-AR-pilot.csv,prolific-study-es-AR-targeted-43-plus-20-controls.csv}"
    },
    "api/translations.js": {
      "maxDuration": 30
    },
    "api/revalidate-translations.js": {
      "maxDuration": 10
    },
    "api/qa-runs.js": {
      "maxDuration": 30
    },
    "api/qa-assignments.js": {
      "maxDuration": 15
    },
    "api/qa-run-assignment.js": {
      "maxDuration": 15
    },
    "api/qa-refresh-assignments.js": {
      "maxDuration": 15
    },
    "api/qa-active-runs.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/proxy/elevenlabs/voices",
      "destination": "/api/elevenlabs-proxy"
    },
    {
      "source": "/proxy/elevenlabs/(.*)",
      "destination": "/api/elevenlabs-proxy?voice_id=$1"
    },
    {
      "source": "/proxy/translate",
      "destination": "/api/translate-proxy"
    },
    {
      "source": "/proxy/playht",
      "destination": "/api/playht-proxy"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/public/favicon.ico"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard-app.html"
    },
    {
      "source": "/partner-audio-dashboard",
      "destination": "/public/partner-audio-dashboard.html"
    },
    {
      "source": "/audio-approval",
      "destination": "/public/partner-audio-dashboard.html"
    },
    {
      "source": "/audio-approval.html",
      "destination": "/public/partner-audio-dashboard.html"
    },
    {
      "source": "/validation/prolific/es-ar-pilot",
      "destination": "/public/validation/prolific/es-ar-pilot.html"
    },
    {
      "source": "/validation/prolific/es-ar-pilot-results",
      "destination": "/public/validation/prolific/es-ar-pilot-results.html"
    },
    {
      "source": "/translations/:lang/:file*",
      "destination": "/api/translations?lang=:lang&file=:file*"
    },
    {
      "source": "/translations/:lang",
      "destination": "/api/translations?lang=:lang"
    },
    {
      "source": "/translations",
      "destination": "/api/translations"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/adm-packs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/adm0/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
