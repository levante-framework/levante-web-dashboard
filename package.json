{
  "name": "levante-audio-dashboard",
  "version": "2.1.2",
  "description": "Web-based audio dashboard for Levante translations",
  "main": "index.html",
  "homepage": "https://audio-dashboard-levante.vercel.app",
  "scripts": {
    "start": "serve .",
    "build": "npm run build:ts",
    "build:ts": "tsc",
    "build:ts-watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test:ts": "node test-typescript.js",
    "test": "npm run test:ts && npm run test:partner-audio-regression:unit && npm run test:validation-manual-approval:unit && npm run test:move-audio-to-dev:unit",
    "predeploy": "node scripts/fix-existing-tasks.js",
    "deploy": "node scripts/deploy-and-alias.js",
    "deploy:test": "node scripts/deploy-prod.js",
    "deploy:prod": "node scripts/deploy-prod.js --promote",
    "deploy-dev": "npx -y vercel --yes",
    "deploy-bat": "deploy.bat",
    "test:partner-audio-regression": "node scripts/check-partner-audio-approval-regression.js",
    "test:partner-audio-regression:unit": "node --test scripts/check-partner-audio-approval-regression.test.js",
    "test:validation-manual-approval:unit": "node --test scripts/validation-manual-approval.test.js",
    "test:move-audio-to-dev:unit": "node --experimental-default-type=module --test scripts/move-audio-to-dev.test.js",
    "test:translations-ota": "node --test scripts/crowdin-ota-client.test.js",
    "preflight:locale": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' preflight/preflight-locale.ts",
    "geocoder:build": "node scripts/geocoder/build-geocoder.js",
    "crowdin:screenshots:artifact": "node scripts/build-crowdin-screenshot-artifact.js",
    "crowdin:screenshots:refresh-cache": "node scripts/build-crowdin-screenshot-artifact.js --output-json data/validation/crowdin-screenshot-artifact.json --cache-bucket levante-assets-draft --cache-prefix screenshots --cache-public-base https://storage.googleapis.com/levante-assets-draft",
    "crowdin:screenshots:cache-status": "node scripts/check-crowdin-screenshot-cache.js",
    "geocoder:index:autocomplete": "node scripts/geocoder/build-country-autocomplete-index.js",
    "geocoder:index:autocomplete:10": "node scripts/geocoder/build-country-autocomplete-index.js --countries=US,DE,GB,NL,CA,CO,IN,AR,GH,CH",
    "adm:build": "node scripts/adm/build-packs.js",
    "adm:build:co": "node scripts/adm/build-packs.js --countries=CO",
    "adm:build:de": "node scripts/adm/build-packs.js --countries=DE",
    "adm:build:us": "node scripts/adm/build-packs.js --countries=US",
    "adm:build:us-place": "node scripts/us/build-us-place-boundaries.js --states=AK,CA,FL,IL,MI,MN,MT,NY,OR,TX --year=2024 --precision=3 --maxPoints=300",
    "validation:estimate": "node scripts/estimate-validation-cost.js",
    "validation:precalibrate": "python3 scripts/precalibrate_validation_without_humans.py",
    "validation:pull-shared": "node scripts/fetch-shared-validation-results.js",
    "validation:precalibrate:shared": "npm run validation:pull-shared && npm run validation:precalibrate -- --validation-json data/validation/validation_results.shared.json",
    "validation:seed-human-review": "python3 scripts/build_human_review_seed.py",
    "validation:train-weak-review-model": "python3 scripts/train_weak_needs_review_model.py",
    "validation:build-weak-review-policy": "python3 scripts/build_review_policy_from_weak_scores.py",
    "validation:build-augmented-review-candidates": "python3 scripts/build_rule_augmented_review_candidates.py",
    "validation:embedding-margin": "python3 scripts/embedding_hard_negative_margin.py",
    "validation:embedding-bakeoff": "python3 scripts/embedding_bakeoff_against_human.py",
    "validation:embedding-add-gemini": "python3 scripts/embedding_add_gemini_details.py",
    "validation:backtranslate:benchmark": "python3 scripts/benchmark_backtranslation_providers.py",
    "validation:backtranslate:hf": "python3 scripts/hf_backtranslation.py --mode roundtrip --text \"This is a test string.\" --source-locale en --target-locale fr-CA",
    "validation:backfill-backtranslations": "node scripts/backfill-validation-backtranslations.js",
    "validation:prolific:export": "python3 scripts/export_prolific_translation_study.py",
    "validation:prolific:import": "python3 scripts/import_prolific_results.py",
    "validation:prolific:export:pilot-es-ar": "python3 scripts/export_prolific_translation_study.py --translations-csv data/validation/crowdin-xliff-merged.csv --target-col es-AR --sample-size 180 --seed 42 --output-csv data/validation/prolific-study-es-AR-pilot.csv",
    "validation:prolific:import:pilot-es-ar": "python3 scripts/import_prolific_results.py --translations-csv data/validation/crowdin-xliff-merged.csv --target-col es-AR --output-prefix data/validation/prolific-es-AR-pilot",
    "validation:seed-by-language": "node scripts/seed-validation-by-language-from-legacy.js",
    "validation:cleanup-artifacts": "python3 scripts/cleanup_validation_artifacts.py",
    "validation:cleanup-artifacts:apply": "python3 scripts/cleanup_validation_artifacts.py --apply"
  },
  "keywords": [
    "audio",
    "dashboard",
    "tts",
    "translations"
  ],
  "author": "Levante Team",
  "license": "MIT",
  "dependencies": {
    "@crowdin/ota-client": "^2.1.0",
    "@google-cloud/storage": "^7.19.0",
    "@google/generative-ai": "^0.24.1",
    "@levante-framework/levante-zod": "^1.0.6",
    "@turf/area": "^7.3.0",
    "@turf/boolean-point-in-polygon": "^7.3.0",
    "@turf/centroid": "^7.3.1",
    "@turf/distance": "^7.3.1",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.2",
    "google-auth-library": "^10.6.1",
    "h3-js": "^4.4.0",
    "node-id3": "^0.2.9",
    "osmtogeojson": "^3.0.0-beta.5",
    "puppeteer": "^24.31.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.33.2",
    "unzipper": "^0.12.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.58.2",
    "serve": "^14.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "gaxios": "^7.1.3",
    "google-auth-library": "^10.6.1",
    "retry-request": "^8.0.2",
    "teeny-request": "^10.1.2",
    "basic-ftp": "^5.2.0",
    "osmtogeojson": {
      "@xmldom/xmldom": "^0.8.11"
    }
  }
}
